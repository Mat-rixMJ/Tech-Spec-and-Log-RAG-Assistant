# Copy to .env for local use, or set these in Render. Never commit the real .env.

# Force the synthetic churn dataset even if data/telco_churn.csv is present.
# Leave unset to use the real Telco CSV when available (see data/README.md).
CHURN_USE_SYNTHETIC=0

LLM_PROVIDER=gemini
# Free key at https://aistudio.google.com/apikey. Without it, the app runs in
# demo mode (RAG/email show retrieved context instead of generated text).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Comma-separated frontend origins allowed to call the API (CORS).
# In prod add your Netlify URL, e.g. https://custiq-mj.netlify.app
CUSTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
